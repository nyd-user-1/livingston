# sam — environment. Copy to .env.local and fill in. Never commit the real file.
# .gitignore already covers .env*.

# ── Required ──────────────────────────────────────────────────────────────
# Neon Postgres holding the preprint corpus, chat_sessions, and research_feed.
# Every api/* function reads this. Pooled host.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Amazon Bedrock, for /api/chat. Bearer-token auth only — no AWS key pair.
AWS_BEARER_TOKEN_BEDROCK=

# ── Search encoder ────────────────────────────────────────────────────────
# Which query encoder /api/search uses. "bge" = stock bge-m3 on Cloudflare
# Workers AI (needs the two CF vars). "nsr" = the self-hosted fine-tuned
# encoder (needs the NSR_* vars). Unset behaves as "bge".
SEARCH_ENCODER=bge
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Self-hosted encoder/reranker, only when SEARCH_ENCODER=nsr.
NSR_ENCODER_URL=
NSR_RERANKER_URL=
NSR_SERVE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Opt-in cross-encoder rerank ("1" to enable; also togglable per request).
SEARCH_RERANK=
# Bedrock region + guardrail for /api/grounding. Region defaults to us-east-2.
BEDROCK_REGION=
BEDROCK_API_KEY=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Enrichment / full-text fetch politeness.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
NCBI_API_KEY=
HF_TOKEN=

# ── Bulk loading only — NOT needed to run the app ─────────────────────────
# Unpooled host. sam does not load data; kept for parity with the schema owner.
DATABASE_URL_UNPOOLED=
