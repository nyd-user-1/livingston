# livingston — environment. Copy to .env.local and fill in. Never commit the real file.
# .gitignore already covers .env*.

# ── Required ──────────────────────────────────────────────────────────────
# Neon Postgres holding the preprint corpus, chat_sessions, and research_feed.
# Every api/* function reads this. Pooled host.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Amazon Bedrock, for /api/chat. A service-specific credential from the IAM user
# livingston-bedrock-invoke. NOTE: Vercel reserves every AWS_* name, so this cannot be
# called AWS_BEARER_TOKEN_BEDROCK — api/chat.ts copies it into that variable
# in-process at call time.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1

# ── Search encoder ────────────────────────────────────────────────────────
# Which query encoder /api/search uses. "bge" = stock bge-m3 on Cloudflare
# Workers AI (needs the two CF vars). "nsr" = the self-hosted fine-tuned
# encoder (needs the NSR_* vars). Unset behaves as "bge".
SEARCH_ENCODER=bge
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Self-hosted encoder/reranker, only when SEARCH_ENCODER=nsr.
NSR_ENCODER_URL=
NSR_RERANKER_URL=
NSR_SERVE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Opt-in cross-encoder rerank ("1" to enable; also togglable per request).
SEARCH_RERANK=
# Guardrail for /api/grounding.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Enrichment / full-text fetch politeness.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
NCBI_API_KEY=
HF_TOKEN=

# ── Bulk loading only — NOT needed to run the app ─────────────────────────
# Unpooled host. livingston does not load data; kept for parity with the schema owner.
DATABASE_URL_UNPOOLED=

# Email delivery of a finished application (api/send-application.ts).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# New York State bills for the Bills rail (api/bills.ts) — the NY Senate Open
# Legislation API, https://legislation.nysenate.gov (free key, per account).
NYS_LEGISLATION_API_KEY=

# Cron/manual trigger secret for api/bills-sync.ts (Vercel sends it as a Bearer token).
CRON_SECRET=
# policy-nysgpt on Neon, which api/bills-sync.ts keeps current. Read/write to Bills, Sponsors only.
POLICY_DATABASE_URL=

# LegiScan API (api.legiscan.com) — NY roll-call votes and change_hash updates; non-commercial key.
LEGISCAN_API_KEY=

# FollowTheMoney (api.followthemoney.org) — campaign finance for People (api/ftm-sync.ts).
# The key is on your myFollowTheMoney account page.
FOLLOWTHEMONEY_API_KEY=

# OpenFEC (api.open.fec.gov) — federal campaign finance for Congress members (api/fec-sync.ts).
# Free key from https://api.data.gov/signup/ — 1,000 requests an hour.
FEC_API_KEY=
# Senate Lobbying Disclosure Act API (lda.gov/api) — who lobbied on which federal bill (api/lda-sync.ts).
# Register at https://lda.gov/api/ ; the key raises the anonymous throttle.
LDA_API_KEY=
