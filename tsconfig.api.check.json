// Typecheck for api/ — NOT part of `npm run build`.
//
// `tsc -b` follows tsconfig.app.json (include: ["src"]) and tsconfig.node.json
// (include: ["vite.config.ts"]). Neither includes api/, so a green `npm run build`
// says nothing about the serverless functions; Vercel typechecks them separately at
// deploy time, which is a slow place to learn about a type error.
//
//   npx tsc -p tsconfig.api.check.json
//
// As of 2026-08-20 this reports 8 PRE-EXISTING errors (api/chat.ts:246 and 7 in
// api/paper.ts) that predate the serving flip and are not fixed here. It is useful as
// a DELTA check — run it before and after a change to api/ and compare — not as a
// pass/fail gate, until those are cleaned up. Do not wire it into CI before then.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true
  },
  "include": ["api/**/*.ts"]
}
