{
  "functions": {
    "api/*.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/bills-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/legiscan-sync?mode=delta&state=NY",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/legiscan-sync?mode=delta&state=NJ",
      "schedule": "40 10 * * *"
    },
    {
      "path": "/api/legiscan-sync?mode=delta&state=US",
      "schedule": "50 10 * * *"
    },
    {
      "path": "/api/legiscan-sync?mode=dataset&state=NY&session=2188",
      "schedule": "0 11 * * 0"
    },
    {
      "path": "/api/legiscan-sync?mode=dataset&state=NJ&session=2250",
      "schedule": "20 11 * * 0"
    },
    {
      "path": "/api/legiscan-sync?mode=dataset&state=US&session=2199",
      "schedule": "40 11 * * 0"
    }
  ]
}
